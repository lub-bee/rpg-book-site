# Password of the book's lock (private book, acces "prive") and default password of private sections.
LIVRE_MOT_DE_PASSE=
# Random secret signing the seal cookies (e.g. `openssl rand -hex 32`). Required as soon as anything is locked.
LIVRE_SECRET=
# A private section may name its own password variable in its section.json ("motDePasseEnv"), e.g.:
# RESERVE_MOT_DE_PASSE=
